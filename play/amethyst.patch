+package net.kdt.pojavlaunch.afkbot;
+
+import android.app.Activity;
+import android.content.Intent;
+import android.os.Bundle;
+import android.widget.Toast;
+
+import net.kdt.pojavlaunch.TestStorageActivity;
+
+/**
+ * Entry point used by the AFK Bot app ("Play" button): it hands over the Minecraft login it already has, the server
+ * and its game version. Only apps signed with the same key can start this activity (signature permission), so the
+ * login never leaves the user's own two apps.
+ *
+ * We only store the request here and then go through the launcher's normal start-up (storage check, unpacking the
+ * runtime components), so the very first launch works too. AfkBotHandoff does the rest once the launcher is up.
+ */
+public class HandoffActivity extends Activity {
+    @Override
+    protected void onCreate(Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+        Intent in = getIntent();
+        String token = in.getStringExtra("accessToken"), uuid = in.getStringExtra("uuid"), name = in.getStringExtra("name");
+        String server = in.getStringExtra("server"), version = in.getStringExtra("version");
+        if (token == null || uuid == null || name == null || server == null) {
+            Toast.makeText(this, "AFK Bot didn't send a login - open Play from AFK Bot again", Toast.LENGTH_LONG).show();
+            finish();
+            return;
+        }
+        AfkBotHandoff.store(this, token, uuid, name, server, version == null || version.isEmpty() ? "1.21.11" : version);
+        Intent start = new Intent(this, TestStorageActivity.class);
+        start.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK | Intent.FLAG_ACTIVITY_CLEAR_TASK);
+        startActivity(start);
+        finish();
+    }
+}
