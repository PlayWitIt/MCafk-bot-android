diff --git a/app_pojavlauncher/src/main/java/net/kdt/pojavlaunch/afkbot/AfkBotHandoff.java b/app_pojavlauncher/src/main/java/net/kdt/pojavlaunch/afkbot/AfkBotHandoff.java
