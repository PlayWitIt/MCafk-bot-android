index 0000000..d4a731b
--- /dev/null
+++ b/app_pojavlauncher/src/main/java/net/kdt/pojavlaunch/afkbot/AfkBotHandoff.java
@@ -0,0 +1,135 @@
+package net.kdt.pojavlaunch.afkbot;
+
+import android.app.Activity;
+import android.content.Context;
+import android.content.Intent;
+import android.content.SharedPreferences;
+import android.preference.PreferenceManager;
+import android.util.Log;
+
+import net.kdt.pojavlaunch.PojavProfile;
+import net.kdt.pojavlaunch.Tools;
+import net.kdt.pojavlaunch.extra.ExtraConstants;
+import net.kdt.pojavlaunch.extra.ExtraCore;
+import net.kdt.pojavlaunch.prefs.LauncherPreferences;
+import net.kdt.pojavlaunch.value.MinecraftAccount;
+import net.kdt.pojavlaunch.value.launcherprofiles.LauncherProfiles;
+import net.kdt.pojavlaunch.value.launcherprofiles.MinecraftProfile;
+
+/**
+ * Glue between the AFK Bot app and this launcher:
+ * 1. store():   the hand-off request (login, server, version) from HandoffActivity
+ * 2. prepare(): when the launcher opens, install that login as the current account and an "AFK Bot server"
+ *               profile on the server's version
+ * 3. launchIfArmed(): once the version list is loaded, press Play
+ * 4. quickPlayServer(): the game joins the server straight away (--quickPlayMultiplayer), once
+ * 5. resumeAfk(): when the game closes, reopen AFK Bot so the bot can take the account back
+ */
+public final class AfkBotHandoff {
+    private static final String TAG = "AfkBotHandoff";
+    private static final String PREFS = "afkbot_handoff";
+    private static final String K_QUICKPLAY = "afkbot_quickplay", K_QUICKPLAY_AT = "afkbot_quickplay_at", K_ACTIVE = "afkbot_active";
+    static final String PROFILE_KEY = "afkbot";
+    private static final long FRESH_MS = 10 * 60 * 1000L;
+
+    private static volatile boolean armed;
+
+    private AfkBotHandoff() {
+    }
+
+    static void store(Context ctx, String token, String uuid, String name, String server, String version) {
+        ctx.getSharedPreferences(PREFS, Context.MODE_PRIVATE).edit()
+                .putString("token", token).putString("uuid", uuid).putString("name", name)
+                .putString("server", server).putString("version", version)
+                .putLong("at", System.currentTimeMillis()).putBoolean("pending", true)
+                .commit();
+    }
+
+    /** Called from LauncherActivity.onCreate (after storage is ready, before the account list is shown). */
+    public static void prepare(Context ctx) {
+        SharedPreferences p = ctx.getSharedPreferences(PREFS, Context.MODE_PRIVATE);
+        if (!p.getBoolean("pending", false)) return;
+        String token = p.getString("token", null);
+        p.edit().putBoolean("pending", false).remove("token").commit(); // used once, never kept on disk
+        if (token == null || System.currentTimeMillis() - p.getLong("at", 0) > FRESH_MS) return; // stale request: ignore
+        try {
+            String name = p.getString("name", "Player"), uuid = p.getString("uuid", ""), server = p.getString("server", "");
+            String version = p.getString("version", "1.21.11");
+            MinecraftAccount acc = new MinecraftAccount();
+            acc.accessToken = token;
+            acc.profileId = uuid;
+            acc.username = name;
+            acc.xuid = "0";
+            // Not a Microsoft account from this launcher's point of view: AFK Bot owns the Microsoft login and sends
+            // a fresh Minecraft token every time, so this launcher must not try to refresh it with its own client id.
+            acc.isMicrosoft = false;
+            acc.expiresAt = System.currentTimeMillis() + 3 * 60 * 60 * 1000L;
+            acc.save();
+            PojavProfile.setCurrentProfile(ctx, name);
+
+            LauncherProfiles.load();
+            MinecraftProfile prof = LauncherProfiles.mainProfileJson.profiles.get(PROFILE_KEY);
+            if (prof == null) {
+                prof = new MinecraftProfile();
+                prof.name = "AFK Bot server";
+            }
+            prof.lastVersionId = version;
+            LauncherProfiles.mainProfileJson.profiles.put(PROFILE_KEY, prof);
+            LauncherProfiles.write();
+
+            SharedPreferences d = defaults(ctx);
+            d.edit().putString(LauncherPreferences.PREF_KEY_CURRENT_PROFILE, PROFILE_KEY)
+                    .putString(K_QUICKPLAY, server).putLong(K_QUICKPLAY_AT, System.currentTimeMillis())
+                    .putBoolean(K_ACTIVE, true)
+                    .commit();
+            armed = true;
+            Log.i(TAG, "Hand-off ready: " + name + " -> " + server + " on " + version);
+        } catch (Exception e) {
+            Log.e(TAG, "Couldn't prepare the hand-off", e);
+        }
+    }
+
+    /** Called once the launcher has its version list: start the game for the hand-off, if there is one. */
+    public static void launchIfArmed(final Activity a) {
+        if (!armed) return;
+        armed = false;
+        a.runOnUiThread(new Runnable() {
+            public void run() {
+                ExtraCore.setValue(ExtraConstants.LAUNCH_GAME, true);
+            }
+        });
+    }
+
+    /** Server the game should join right away, or null. Consumed: a later normal launch starts at the title screen. */
+    public static String quickPlayServer() {
+        SharedPreferences d = LauncherPreferences.DEFAULT_PREF;
+        if (d == null) return null;
+        String s = d.getString(K_QUICKPLAY, null);
+        long at = d.getLong(K_QUICKPLAY_AT, 0);
+        if (s == null) return null;
+        d.edit().remove(K_QUICKPLAY).remove(K_QUICKPLAY_AT).commit();
+        return System.currentTimeMillis() - at < 30 * 60 * 1000L && !s.trim().isEmpty() ? s.trim() : null;
+    }
+
+    /** The game has closed: give the account back to the AFK bot. Returns true if AFK Bot was opened. */
+    public static boolean resumeAfk(Context ctx) {
+        try {
+            SharedPreferences d = defaults(ctx);
+            if (!d.getBoolean(K_ACTIVE, false)) return false;
+            d.edit().putBoolean(K_ACTIVE, false).commit();
+            Intent i = new Intent("app.afkbot.action.RESUME_AFK");
+            i.setClassName("app.afkbot", "app.afkbot.ResumeAfk");
+            i.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK);
+            ctx.startActivity(i);
+            return true;
+        } catch (Exception e) {
+            Log.e(TAG, "Couldn't reopen AFK Bot", e);
+            return false;
+        }
+    }
+
+    private static SharedPreferences defaults(Context ctx) {
+        SharedPreferences d = LauncherPreferences.DEFAULT_PREF;
+        return d != null ? d : PreferenceManager.getDefaultSharedPreferences(ctx);
+    }
+}
